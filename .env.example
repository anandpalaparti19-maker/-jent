# JENT Job Search Agent — Environment Variables Template
# Copy this file to .env and fill in your values.
# OR edit config.yaml directly (recommended).
# Environment variables always override config.yaml.

# ── Gmail ─────────────────────────────────────────────────────────────────────
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_TO_ADDRESS=you@gmail.com
FORCE_DIRECT_GMAIL=false

# ── Zapier ────────────────────────────────────────────────────────────────────
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/123456/abcdef/

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# ── Matching ──────────────────────────────────────────────────────────────────
RESUME_PATH=resume.pdf
SIMILARITY_THRESHOLD=0.12
TITLE_BOOST_MULTIPLIER=1.4
LEVEL_FILTERS=intern,internship,entry level,junior,new grad,graduate
CHECK_INTERVAL_HOURS=2

# ── Location ──────────────────────────────────────────────────────────────────
PREFER_REMOTE=true
PREFERRED_LOCATIONS=

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/jent
DEFAULT_USER_ID=default_user

# ── Cashfree Subscription ───────────────────────────────────────────────────
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
CASHFREE_ENV=test
SUBSCRIPTION_AMOUNT=75
SUBSCRIPTION_REQUIRED=true
